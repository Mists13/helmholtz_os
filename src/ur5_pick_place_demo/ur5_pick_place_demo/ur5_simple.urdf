<?xml version="1.0" ?>
<robot name="ur5_simple">
  <!-- Minimal 6-DOF UR5-like robot for visualization in RViz -->

  <link name="base_link">
    <inertial>
      <mass value="5.0" />
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01" />
    </inertial>
    <visual>
      <geometry>
        <box size="0.2 0.2 0.02" />
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="base_color">
        <color rgba="0.5 0.5 0.5 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.2 0.2 0.02" />
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
  </link>

  <!-- Link 1 -->
  <link name="link1">
    <visual>
      <geometry>
        <cylinder length="0.2" radius="0.05" />
      </geometry>
      <origin xyz="0 0 0.1" rpy="0 0 0" />
    </visual>
  </link>

  <!-- Link 2 -->
  <link name="link2">
    <visual>
      <geometry>
        <cylinder length="0.25" radius="0.04" />
      </geometry>
      <origin xyz="0 0 0.125" rpy="0 0 0" />
    </visual>
  </link>

  <!-- Link 3 -->
  <link name="link3">
    <visual>
      <geometry>
        <cylinder length="0.2" radius="0.035" />
      </geometry>
      <origin xyz="0 0 0.1" rpy="0 0 0" />
    </visual>
  </link>

  <!-- Link 4 -->
  <link name="link4">
    <visual>
      <geometry>
        <cylinder length="0.15" radius="0.03" />
      </geometry>
      <origin xyz="0 0 0.075" rpy="0 0 0" />
    </visual>
  </link>

  <!-- Link 5 -->
  <link name="link5">
    <visual>
      <geometry>
        <cylinder length="0.12" radius="0.025" />
      </geometry>
      <origin xyz="0 0 0.06" rpy="0 0 0" />
    </visual>
  </link>

  <!-- Link 6 / end effector -->
  <link name="link6">
    <visual>
      <geometry>
        <sphere radius="0.04" />
      </geometry>
      <origin xyz="0 0 0.04" rpy="0 0 0" />
    </visual>
  </link>

  <!-- Joints (names match joint_republisher) -->
  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.01" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="0" velocity="0"/>
  </joint>

  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="0" velocity="0"/>
  </joint>

  <joint name="elbow_joint" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="0" velocity="0"/>
  </joint>

  <joint name="wrist_1_joint" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="0" velocity="0"/>
  </joint>

  <joint name="wrist_2_joint" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="0" velocity="0"/>
  </joint>

  <joint name="wrist_3_joint" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="0" velocity="0"/>
  </joint>

</robot>
